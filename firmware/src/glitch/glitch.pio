; ============================================================================
; Faulter PIO Glitch Engine - Ultra-High-Performance Single-Cycle Architecture
; ============================================================================
;
; True single-cycle hardware resolution via RP2040 PIO:
;   - At 250 MHz each PIO cycle is exactly 4.00 ns.
;   - Dynamic pulse widths: Y = 0 produces exactly 1 cycle (4.00 ns).
;                           Y = 1 produces exactly 2 cycles (8.00 ns).
;                           Y = N produces exactly (N + 1) cycles.
;
; Both delay and pulse width counts are pre-loaded BEFORE the glitch pin is
; asserted, completely eliminating CPU FIFO stall latency.

.program glitch_engine

.wrap_target
    pull block          ; Wait for delay cycle count from TX FIFO
    mov x, osr          ; Load delay counter into X

    pull block          ; Wait for pulse width cycle count from TX FIFO
    mov y, osr          ; Load pulse width counter into Y

    jmp !x skip_delay   ; If delay is 0, skip delay loop immediately
delay_loop:
    jmp x-- delay_loop  ; Decrement X; loop while X > 0 (1 cycle per iter)
skip_delay:

    ; Pulse Generation Logic:
    ; Y is cycle count - 1 (0 -> 1 cycle, 1 -> 2 cycles, N -> N+1 cycles)
    jmp !y pulse_1      ; Y == 0: branch to true 1-cycle single-instruction pulse
    jmp y-- check_2     ; Y > 0: decrement Y and check if it was 1
check_2:
    jmp !y pulse_2      ; Y was 1 (now 0): branch to 2-cycle pulse

    ; For Y >= 2 (3 or more cycles):
    set pins, 1         ; Pin goes HIGH
pulse_loop:
    jmp y-- pulse_loop  ; Loops for remaining cycles while pin is HIGH
    set pins, 0         ; Pin returns to LOW
    jmp done

pulse_1:
    set pins, 1         ; Cycle 1: Pin goes HIGH
    set pins, 0         ; Cycle 2: Pin goes LOW (duration HIGH: EXACTLY 1 cycle!)
    jmp done

pulse_2:
    set pins, 1 [1]     ; Cycle 1: Pin goes HIGH, held for 1 extra cycle = 2 cycles
    set pins, 0         ; Cycle 3: Pin goes LOW (duration HIGH: EXACTLY 2 cycles!)

done:
    irq wait 0          ; Signal IRQ 0 and wait for CPU to acknowledge/clear it
.wrap

% c-sdk {
#include "hardware/gpio.h"

/**
 * @brief Initialize the glitch_engine PIO program.
 *
 * @param pio       PIO instance (pio0 or pio1)
 * @param sm        State machine index (0–3)
 * @param offset    Instruction memory offset from pio_add_program()
 * @param pin       GPIO pin number for glitch output
 */
static inline void glitch_engine_program_init(PIO pio, uint sm, uint offset,
                                              uint pin) {
    /* Configure the set pin */
    pio_sm_config c = glitch_engine_program_get_default_config(offset);
    sm_config_set_set_pins(&c, pin, 1);

    /* Initialize pin: output, LOW */
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);
    gpio_put(pin, 0);

    /* MAXIMUM SLEW AND DRIVE PERFORMANCE:
     * Switch GPIO to FAST slew rate and 12 mA drive strength.
     * Default RP2040 4 mA slow slew rate produces ~7-10 ns rise times,
     * rounding off narrow nanosecond pulses and degrading amplitude.
     * 12 mA fast slew delivers < 1 ns edge transitions and full 3.3V amplitude. */
    gpio_set_slew_rate(pin, GPIO_SLEW_RATE_FAST);
    gpio_set_drive_strength(pin, GPIO_DRIVE_STRENGTH_12MA);

    /* No clock divider — run at full sys_clk (250 MHz) */
    sm_config_set_clkdiv(&c, 1.0f);

    /* Initialize and enable the state machine */
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
